# Gere uma chave com pelo menos 32 bytes aleatÃ³rios codificados em Base64.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_BASE64_ALEATORIA

# Twitch/IGDB
IGDB_CLIENT_ID=coloque_seu_client_id_aqui
IGDB_CLIENT_SECRET=coloque_seu_client_secret_aqui
